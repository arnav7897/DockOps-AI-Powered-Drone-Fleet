MONGODB_URI=mongodb://127.0.0.1:27017/droneops?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
STALE_AFTER_MS=60000

# Optional MQTT connection
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=backend
# MQTT_PASSWORD=replace-me
# MQTT_CLIENT_ID=droneops-backend

# Optional OpenAI-compatible chat endpoint
# AI_API_BASE_URL=https://api.example.com/v1
# AI_API_KEY=replace-me
# AI_MODEL=your-model-name
